generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Client {
  id           String    @id @default(uuid())
  fullName     String
  contactNo    String    @unique
  alternateNo  String?
  email        String?
  address      String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  enquiries    Enquiry[]

  @@map("clients")
}

model Enquiry {
  id                     String    @id @default(uuid())
  clientId               String?
  client                 Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  fullName               String
  contactNo              String
  purpose                String
  caseNumber             String?
  assignedAdvocate       String?
  lawyerId               String?
  lawyer                 Lawyer?   @relation(fields: [lawyerId], references: [id], onDelete: Restrict)
  feesPaid               Decimal   @default(0) @db.Decimal(12, 2)
  urgency                String    @default("Normal") // Normal, High, Urgent
  status                 String    @default("Waiting") // Waiting, In Consultation, Completed, Rescheduled
  notes                  String?
  entryTime              DateTime  @default(now())
  consultationStartTime  DateTime?
  consultationEndTime    DateTime?
  deletedAt              DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  notificationJobs       NotificationJob[]

  @@index([entryTime])
  @@index([contactNo])
  @@index([status])
  @@index([status, entryTime])
  @@index([urgency, entryTime])
  @@index([deletedAt, entryTime])
  @@index([lawyerId])
  @@map("enquiries")
}

model IntegrationSettings {
  id               String   @id
  encryptedPayload String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("integration_settings")
}

model NotificationJob {
  id            String   @id @default(uuid())
  enquiryId     String
  enquiry       Enquiry  @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  status        String   @default("PENDING")
  attempts      Int      @default(0)
  nextAttemptAt DateTime @default(now())
  lockedAt      DateTime?
  lastError     String?
  result        Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status, nextAttemptAt])
  @@index([enquiryId])
  @@map("notification_jobs")
}

model Lawyer {
  id             String    @id @default(uuid())
  name           String    @unique
  username       String?   @unique
  passwordHash   String?
  role           String    @default("lawyer")
  phone          String?
  email          String?
  assignedTasks  String[]  @default([])
  isActive       Boolean   @default(true)
  authVersion    Int       @default(1)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  enquiries      Enquiry[]

  @@map("lawyers")
}

model AuditLog {
  id         String   @id @default(uuid())
  enquiryId  String?
  action     String
  changes    Json?
  createdAt  DateTime @default(now())

  @@index([enquiryId, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}
