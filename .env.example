POSTGRES_PASSWORD=replace-with-a-long-random-url-safe-database-password
API_KEY=replace-with-a-different-random-string-at-least-24-characters
# Native Android requests do not send a browser Origin. Leave blank for APK-only use.
CORS_ORIGIN=
RATE_LIMIT_MAX=1000
OFFICE_TIMEZONE_OFFSET_MINUTES=330
LOGIN_USERNAME=replace-with-the-office-login-name
LOGIN_PASSWORD=replace-with-a-strong-private-password
AUTH_SECRET=replace-with-a-random-string-at-least-32-characters
AUTH_TOKEN_TTL_HOURS=168
LOGIN_RATE_LIMIT_MAX=10
# Optional for later native builds; used only when a 10-digit WhatsApp number has no country code.
EXPO_PUBLIC_DEFAULT_COUNTRY_CODE=91
# Optional SMS notification webhook/gateway URL with variables {name}, {reason}, etc.
SMS_NOTIFICATION_URL=
