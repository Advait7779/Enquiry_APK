POSTGRES_PASSWORD=replace-with-a-long-random-url-safe-database-password
API_KEY=replace-with-a-different-random-string-at-least-24-characters
# Set this to the final admin portal origin (no trailing slash). The APK sends no browser Origin.
CORS_ORIGIN=https://admin.clients.example.com
RATE_LIMIT_MAX=1000
OFFICE_TIMEZONE_OFFSET_MINUTES=330
LOGIN_USERNAME=replace-with-the-office-login-name
LOGIN_PASSWORD=replace-with-a-strong-private-password
AUTH_SECRET=replace-with-a-random-string-at-least-32-characters
# Optional dedicated encryption key for integration URLs. If empty, AUTH_SECRET is used.
INTEGRATION_ENCRYPTION_KEY=replace-with-a-random-string-at-least-32-characters
AUTH_TOKEN_TTL_HOURS=168
LOGIN_RATE_LIMIT_MAX=10
# Optional for later native builds; used only when a 10-digit WhatsApp number has no country code.
EXPO_PUBLIC_DEFAULT_COUNTRY_CODE=91
# Optional one-time SMS bootstrap URL. Prefer saving a rotated URL in the admin panel.
SMS_NOTIFICATION_URL=
# Leave empty for the Compose Nginx /api proxy. For a separate admin deployment,
# set this to the public backend origin (for example https://api.example.com).
VITE_API_BASE_URL=
